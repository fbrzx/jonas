# Jonas Agent - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Model Provider Configuration
# =============================================================================

# Provider selection: "claude" or "ollama"
MODEL_PROVIDER=claude

# Claude Configuration (when MODEL_PROVIDER=claude)
CLAUDE_MODEL=claude-sonnet-4-6 # Used only when MODEL_PROVIDER=claude
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your-token-here

# Ollama Configuration (when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest

# Ollama/Tooling Stability Guards (recommended for local models)
AGENT_OLLAMA_TOOLS_ENABLED=false
AGENT_OLLAMA_GROUNDING_MODE=warn
AGENT_MODEL_TURN_TIMEOUT_MS=15000
VOYAGE_TIMEOUT_MS=15000

# =============================================================================
# Multi-Agent Swarm Tuning
# =============================================================================
# These defaults are tuned for a mixed swarm (e.g. Sonnet + Opus + Haiku).
# Per-agent model selection is configured in the agents DB table, not here.

# Timeouts
AGENT_MODEL_TURN_TIMEOUT_MS_CLAUDE=180000  # 3min — Opus needs longer turns
AGENT_TOOL_TIMEOUT_MS=20000                # 20s — some skills/OAuth are slow

# Tool execution limits
AGENT_TOOL_MAX_TURNS=6                     # More tool chaining for complex tasks
AGENT_TOOL_MAX_REPEAT=3                    # Allow iterative search/memory loops

# Delegation & concurrency
AGENT_MAX_DELEGATION_DEPTH=3               # 3-tier: Router → Thinker → Worker
AGENT_MAX_CONCURRENT_JOBS=8                # Haiku is cheap, run more in parallel
AGENT_JOB_TIMEOUT_MS=600000                # 10min per job (delegation routes here)
AGENT_JOB_HISTORY_SIZE=200                 # Keep more history for debugging

# Context limits
AGENT_MAX_TOOL_RESULT_CHARS=6000           # Richer context for Opus
AGENT_MAX_HISTORY_MSG_CHARS=1500           # Better conversation continuity

# =============================================================================
# Memory & Embeddings
# =============================================================================

QDRANT_URL=http://qdrant:6333
VOYAGE_API_KEY=your-voyage-api-key-here

# =============================================================================
# Services
# =============================================================================

# Agent API
AGENT_PORT=3001
AGENT_API_URL=http://agent:3001
AGENT_API_TOKEN=your-secure-agent-api-token-here

# Gateway (WebSocket for Claude Code CLI)
GATEWAY_PORT=18789
GATEWAY_TOKEN=your-secure-gateway-token-here

# Dashboard (127.0.0.1 only, SSH tunnel required)
DASHBOARD_PORT=3000
DASHBOARD_TOKEN=your-secure-dashboard-token-here
DASHBOARD_COOKIE_SECURE=false

# Uncomment and set if using OAuth with a redirect domain (e.g., for Claude Code CLI authentication)
# OAUTH_REDIRECT_DOMAIN=http://localhost:3000