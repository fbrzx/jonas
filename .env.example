# ==============================================================================
# Jonas — Environment Variables
# Copy this file to .env and fill in your values:  cp env.example .env
# ==============================================================================

# --- Required ---

# Claude Code OAuth token (sk-ant-oat01-...)
CLAUDE_CODE_OAUTH_TOKEN=

# Shared token for agent API authentication (gateway + dashboard → agent)
AGENT_API_TOKEN=

# Gateway WebSocket auth token (CLI clients → gateway)
GATEWAY_TOKEN=

# Dashboard login password
DASHBOARD_TOKEN=

# --- Memory (Voyage AI) ---

# Voyage AI API key for embeddings (free tier: 3 RPM)
VOYAGE_API_KEY=

# Voyage API timeout in ms (default: 15000)
# VOYAGE_TIMEOUT_MS=15000

# --- Security ---

# HMAC secret for dashboard cookie signing (generate a random string)
# If unset, falls back to a hardcoded default — set this in production!
DASHBOARD_COOKIE_SECRET=

# Set to true when serving dashboard over HTTPS
# DASHBOARD_COOKIE_SECURE=false

# AES-256 hex key for skill vault encryption (64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SKILLS_ENCRYPTION_KEY=

# --- Model Configuration ---

# Model provider: claude | ollama
# MODEL_PROVIDER=claude

# Claude model to use
# CLAUDE_MODEL=claude-sonnet-4-6

# Claude CLI max agentic turns per invocation
# CLAUDE_MAX_TURNS=30

# Ollama settings (when MODEL_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5-coder:latest

# --- Agent Tuning ---

# Max actions (tool calls) per minute
# AGENT_MAX_ACTIONS_PER_MINUTE=30

# Model turn timeout (non-Claude providers), in ms
# AGENT_MODEL_TURN_TIMEOUT_MS=30000

# Model turn timeout for Claude provider, in ms (Opus needs longer)
# AGENT_MODEL_TURN_TIMEOUT_MS_CLAUDE=180000

# Max tool turns per agent invocation
# AGENT_TOOL_MAX_TURNS=6

# Max consecutive identical tool calls before stopping
# AGENT_TOOL_MAX_REPEAT=3

# Individual tool call timeout in ms
# AGENT_TOOL_TIMEOUT_MS=20000

# Max chars returned from a single tool result
# AGENT_MAX_TOOL_RESULT_CHARS=6000

# Max chars per history message before truncation
# AGENT_MAX_HISTORY_MSG_CHARS=1500

# --- Job System (delegations, background tasks) ---

# Max concurrent background jobs
# AGENT_MAX_CONCURRENT_JOBS=8

# Max delegation depth (Jonas → Gandalf → Lucy)
# AGENT_MAX_DELEGATION_DEPTH=3

# Delegation timeout in ms
# AGENT_DELEGATION_TIMEOUT_MS=120000

# Background job timeout in ms
# AGENT_JOB_TIMEOUT_MS=600000

# Max completed jobs kept in history
# AGENT_JOB_HISTORY_SIZE=200

# --- Ollama Grounding (when using Ollama provider) ---

# Enable tool use for Ollama models
# AGENT_OLLAMA_TOOLS_ENABLED=false

# Grounding mode: warn | block | off
# AGENT_OLLAMA_GROUNDING_MODE=warn

# --- OAuth (for channel connections) ---

# Public domain for OAuth redirect URIs (e.g., https://jonas.example.com)
# OAUTH_REDIRECT_DOMAIN=

# --- Channel Pairing ---

# Comma-separated channel types that require pairing
# PAIRING_ENFORCE_CHANNELS=gateway

# Require pairing for dynamically registered (managed) channels
# PAIRING_REQUIRE_MANAGED_CHANNELS=true

# --- Networking ---

# Public domain for the deployment
# DOMAIN=localhost

# --- Logging ---

# Global log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info
