# Jonas Agent - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Model Provider Configuration
# =============================================================================

# Provider selection: "claude" or "ollama"
MODEL_PROVIDER=claude

# Claude Configuration (when MODEL_PROVIDER=claude)
AGENT_DEFAULT_MODEL=claude-sonnet-4-5-20250929 # Align with OLLAMA_MODEL if switching to `MODEL_PROVIDER=ollama`
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your-token-here

# Ollama Configuration (when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest

# =============================================================================
# Memory & Embeddings
# =============================================================================

QDRANT_URL=http://qdrant:6333
VOYAGE_API_KEY=your-voyage-api-key-here

# =============================================================================
# Services
# =============================================================================

# Agent API
AGENT_PORT=3001
AGENT_API_URL=http://agent:3001

# Gateway (WebSocket for Claude Code CLI)
GATEWAY_PORT=18789
GATEWAY_TOKEN=your-secure-gateway-token-here

# Dashboard (127.0.0.1 only, SSH tunnel required)
DASHBOARD_PORT=3000
DASHBOARD_TOKEN=your-secure-dashboard-token-here

# Uncomment and set if using OAuth with a redirect domain (e.g., for Claude Code CLI authentication)
# OAUTH_REDIRECT_DOMAIN=http://localhost:3000