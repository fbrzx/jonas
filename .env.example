# Claude Pro OAuth (obtain via `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=

# Voyage AI (for embeddings)
VOYAGE_API_KEY=

# Gateway
GATEWAY_TOKEN=
GATEWAY_PORT=18789

# Dashboard
DASHBOARD_TOKEN=
DASHBOARD_PORT=3000

# Qdrant
QDRANT_URL=http://qdrant:6333

# Agent
AGENT_PORT=3001
AGENT_DEFAULT_MODEL=claude-sonnet-4-5-20250929
AGENT_MAX_ACTIONS_PER_MINUTE=30


DOMAIN=your.domain
