{
  "name": "@jonas/dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && pnpm run copy-assets",
    "dev": "tsup --watch --onSuccess 'node dist/index.js'",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "copy-assets": "mkdir -p dist/assets && cp -R src/assets/. dist/assets/ 2>/dev/null || true",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@jonas/shared": "workspace:*",
    "adm-zip": "^0.5.16",
    "hono": "^4.12.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
